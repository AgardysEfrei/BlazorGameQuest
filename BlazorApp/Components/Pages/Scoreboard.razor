@page "/ScoreBoard"
@attribute [StreamRendering]

<PageTitle>Scoreboard</PageTitle>

<h1>Scoreboard</h1>

<p>Voici les 5 meilleurs parties</p>

@if (forecasts == null)
{
    <p>
        <em>Chargement...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Nom du joueur</th>
            <th>Nombre de donjons explorés</th>
            <th>Nombre d'ennemis tués</th>
            <th>Donjon où le joueur est mort</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var forecast in forecasts)
        {
            <tr>
                <td>@forecast.PlayerName</td>
                <td>@forecast.NumberOfDungeonExplored.ToString()</td>
                <td>@forecast.NumberOfEnnemiesKilled.ToString()</td>
                <td>@forecast.DeathDungeonNumber.ToString()</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private DummyPlayers[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        //Jeux de données bidon
        await Task.Delay(500);
        var playerNames = new[] { "Théo", "Léa", "Homer", "Vicente", "Bart" };
        var numberOfDungeon = new[] { 135, 120, 118, 100, 90 };
        var numberOfEnnemiesKilled = new[] { 200, 185, 160, 165, 120 };
        forecasts = Enumerable.Range(0, 5).Select(index => new DummyPlayers
        {
            PlayerName = playerNames[index],
            NumberOfDungeonExplored = numberOfDungeon[index],
            NumberOfEnnemiesKilled = numberOfEnnemiesKilled[index],
            DeathDungeonNumber = numberOfDungeon[index]+1,
        }).ToArray();
    }

    private class DummyPlayers
    {
        public string PlayerName { get; set; }
        public int NumberOfDungeonExplored { get; set; }
        public int NumberOfEnnemiesKilled { get; set; }
        public int DeathDungeonNumber { get; set; }
    };
}
    