@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BlazorGameQuest</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <AuthorizeView>
                <Authorized>
                    <div class="nav-link">
                        <span class="bi bi-person-fill" aria-hidden="true"></span> @context.User.Identity?.Name
                        @* Logged in as @context.User.Claims.Aggregate("", (s, claim) => s += ";\n" + claim ) *@
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-sword" aria-hidden="true"></span> Aventure
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Leaderboard">
                <span class="bi bi-scoreboard" aria-hidden="true"></span> Leaderboard
            </NavLink>
        </div>
        @if (modeDeConnexion.Equals("joueur"))
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="@($"/ListeParties/{idUtilisateur}")">
                <span class="bi bi-visualisation" aria-hidden="true"></span> ListeDesParties
            </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"/Admin/{idUtilisateur}")">
                    <span class="bi bi-visualisation" aria-hidden="true"></span> Interface Administrateur
                </NavLink>
            </div>
        }
    </nav>
</div>
@code{

    [CascadingParameter(Name = "utilisateurConnecte")]
    public int idUtilisateur { get; set; }
    [CascadingParameter(Name = "modeDeConnexion")]
    public string modeDeConnexion { get; set; }

}